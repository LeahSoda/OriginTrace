# Copy to .env in project root. Used by the backend (with dotenv/config).
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
# Meta Model API credentials: backend only; never use a VITE_ prefix.
MODEL_API_KEY=
# Optional model override; must support images and structured output.
META_MODEL=muse-spark-1.3
TAVILY_API_KEY=
