# Copy to .env in project root. Used by the backend (with dotenv/config).
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Meta Model API credentials: backend only;
META_API_KEY=
META_MODEL=muse-spark-1.3

# Emergency stop: true (or any value except literal false) blocks new Meta calls.
META_API_DISABLED=false
SEARCH_PROVIDER=meta
META_TEXT_COMPARISON=true

# Current speech default is Meta; use local for Whisper, or off to disable speech.
SPEECH_PROVIDER=meta

# Public Instagram metadata fallback (requires yt-dlp; never reads cookies).
PLATFORM_EXTRACTION_ENABLED=true

# Optional executable paths when the backend PATH lacks these tools.
# FFMPEG_COMMAND=/opt/homebrew/bin/ffmpeg
# YTDLP_COMMAND=/opt/homebrew/bin/yt-dlp

# Meta hosted-search adapter is available but requires explicit acceptance of
# best-effort billing instead of the original strict worst-case $100 guarantee.

META_SEARCH_BILLING_MODE=strict
# Only after accepting that tradeoff, use BOTH:
# SEARCH_PROVIDER=meta
# META_SEARCH_BILLING_MODE=best_effort
